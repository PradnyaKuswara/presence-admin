---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import StatsCard from '../components/card/StatsCard.astro';
import StudentAttendanceChart from '../components/chart/StudentAttendanceChart';
import SchoolOverviewCard from '../components/card/SchoolOverviewCard';
import TelegramNotificationWidget from '../components/notification/TelegramNotificationWidget';
import { Badge } from '../components/badge/Badge';
---

<DashboardLayout title="Dashboard Overview - PresenceSaaS Siswa" description="Super Admin Dashboard Portal Presensi Siswa Sekolah.">
  <!-- Welcome Banner (Super Admin Portal Presensi Siswa) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-5 rounded-lg border border-slate-200 dark:border-slate-800 shadow-xs">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Super Admin SaaS Portal</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">Rabu, 9 September 2026</span>
      </div>
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Halo, Super Admin! 👋</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Monitoring presensi siswa sekolah nasional & notifikasi Telegram Bot real-time.</p>
    </div>
    <div class="flex items-center gap-2">
      <Badge client:load variant="success">Sistem Server Normal</Badge>
      <Badge client:load variant="info">Telegram Bot Active</Badge>
    </div>
  </div>

  <!-- Key Super Admin SaaS Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <StatsCard 
      title="Sekolah Terdaftar" 
      value="4 Sekolah" 
      change="+1 Bulan Ini" 
      changeType="positive"
      iconBg="bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-400 dark:border-blue-800/60"
    >
      <svg slot="icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m3 0h1m-1-4h.01M9 16h.01M9 12h.01M9 8h.01M15 16h.01M15 12h.01M15 8h.01" />
      </svg>
    </StatsCard>

    <StatsCard 
      title="Total Siswa Aktif" 
      value="18,450" 
      change="+350 Siswa" 
      changeType="positive"
      iconBg="bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/60"
    >
      <svg slot="icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
      </svg>
    </StatsCard>

    <StatsCard 
      title="Kehadiran Siswa Today" 
      value="94.2%" 
      change="17,380 Tap In" 
      changeType="positive"
      iconBg="bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-400 dark:border-amber-800/60"
    >
      <svg slot="icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </StatsCard>

    <StatsCard 
      title="Mesin Tap RFID" 
      value="3 / 4 Online" 
      change="1 Device Offline" 
      changeType="neutral"
      iconBg="bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700"
    >
      <svg slot="icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </StatsCard>
  </div>

  <!-- Student Attendance Analytics Chart per Level (React Component) -->
  <StudentAttendanceChart client:load />

  <!-- Main Grid Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <!-- Registered Schools Overview Card (React) -->
    <SchoolOverviewCard client:load />

    <!-- Telegram Bot Broadcast & Notification Log Widget (React) -->
    <TelegramNotificationWidget client:load />
  </div>
</DashboardLayout>
