---
import Button from '../button/Button.astro';
import ThemeToggle from './ThemeToggle';
---

<header class="h-16 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-30 px-6 flex items-center justify-between shadow-xs">
  <!-- Left Header -->
  <div class="flex items-center gap-4">
    <button class="md:hidden text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 p-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <div class="hidden sm:flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span>Portal</span>
      <span>/</span>
      <span class="text-slate-900 dark:text-slate-200 font-semibold">Dashboard Overview</span>
    </div>
  </div>

  <!-- Right Header -->
  <div class="flex items-center gap-3">
    <!-- Theme Switcher (Light/Dark Toggle) -->
    <ThemeToggle client:load />

    <!-- Quick Action -->
    <Button variant="primary" size="sm">
      <svg slot="icon-left" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Check-In Manual
    </Button>

    <!-- Notification Bell -->
    <button class="relative p-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 01-6 0v-1m6 0H9" />
      </svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-blue-600 rounded-full"></span>
    </button>
  </div>
</header>
